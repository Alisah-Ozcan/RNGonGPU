cmake_minimum_required(VERSION 3.21)

# ─────────────────────────────────────────────────────────────
# HIP-only project (NO CUDA)
# ─────────────────────────────────────────────────────────────
project(RNGonAMDGPU VERSION 1.0.0 LANGUAGES CXX HIP)

# ─────────────────────────────────────────────────────────────
# 🔥 HARD CUDA DISABLE (must be before any add_subdirectory)
# ─────────────────────────────────────────────────────────────
set(CMAKE_CUDA_COMPILER "NOTFOUND" CACHE FILEPATH "" FORCE)
set(CMAKE_CUDA_ENABLED OFF CACHE BOOL "" FORCE)
set(CMAKE_CUDA_LANGUAGE_ENABLED OFF CACHE BOOL "" FORCE)
set(CUDAToolkit_ROOT "" CACHE PATH "" FORCE)

# Prevent CUDA-enabled third-party (NVBench etc.)
set(NVBench_ENABLE_CUDA OFF CACHE BOOL "" FORCE)
set(NVBench_ENABLE_CUDA_BENCHMARKS OFF CACHE BOOL "" FORCE)

# ─────────────────────────────────────────────────────────────
# ROCm setup
# ─────────────────────────────────────────────────────────────
list(APPEND CMAKE_PREFIX_PATH $ENV{ROCM_PATH})

find_package(hip REQUIRED CONFIG)
find_package(rocrand REQUIRED CONFIG)

# ─────────────────────────────────────────────────────────────
# Language standard
# ─────────────────────────────────────────────────────────────
set(CMAKE_CXX_STANDARD 17)
set(CMAKE_CXX_STANDARD_REQUIRED ON)

set(CMAKE_HIP_STANDARD 17)
set(CMAKE_HIP_STANDARD_REQUIRED ON)

# Target GPU
set(CMAKE_HIP_ARCHITECTURES gfx942)

# ─────────────────────────────────────────────────────────────
# Build type
# ─────────────────────────────────────────────────────────────
if(NOT CMAKE_BUILD_TYPE)
  set(CMAKE_BUILD_TYPE Release CACHE STRING "" FORCE)
endif()

# ─────────────────────────────────────────────────────────────
# Install layout
# ─────────────────────────────────────────────────────────────
include(GNUInstallDirs)

set(RUNTIME_DESTINATION ${CMAKE_INSTALL_BINDIR})
set(LIBRARY_DESTINATION ${CMAKE_INSTALL_LIBDIR})
set(ARCHIVE_DESTINATION ${CMAKE_INSTALL_LIBDIR})
set(INCLUDES_INSTALL_DIR ${CMAKE_INSTALL_INCLUDEDIR}/${PROJECT_NAME}-${PROJECT_VERSION})

set(CMAKE_INSTALL_CMAKEDIR "${CMAKE_INSTALL_LIBDIR}/cmake/${PROJECT_NAME}")

# ─────────────────────────────────────────────────────────────
# Build options
# ─────────────────────────────────────────────────────────────
option(RNGONAMDGPU_BUILD_EXAMPLES   "Build examples"   ON)
option(RNGONAMDGPU_BUILD_BENCHMARKS "Build benchmarks" OFF) # 🔥 disable by default (CUDA risk)
option(RNGONAMDGPU_BUILD_TESTS      "Build tests"      ON)

# ─────────────────────────────────────────────────────────────
# Third-party (HIP-only safe assumption required)
# ─────────────────────────────────────────────────────────────
add_subdirectory(thirdparty)

# ─────────────────────────────────────────────────────────────
# Main source
# ─────────────────────────────────────────────────────────────
add_subdirectory(src)

# ─────────────────────────────────────────────────────────────
# Optional components
# ─────────────────────────────────────────────────────────────
if(RNGONAMDGPU_BUILD_EXAMPLES)
  add_subdirectory(example)
endif()

if(RNGONAMDGPU_BUILD_BENCHMARKS)
  message(FATAL_ERROR "Benchmarks require CUDA/NVBench. Disabled in HIP-only build.")
endif()

if(RNGONAMDGPU_BUILD_TESTS)
  enable_testing()
  add_subdirectory(test)
endif()
